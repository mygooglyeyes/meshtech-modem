# meshtech-modem settings
# Plain key = value. Blank lines and # comments are ignored.
# After editing, restart with:  sudo systemctl restart meshtech-modem

# Address to listen on. 0.0.0.0 = reachable from other machines
# (e.g. openHop on another box). 127.0.0.1 = this machine only.
host = 0.0.0.0

# TCP port openHop connects to. Must match the port set in openHop's
# pymc_tcp radio config.
port = 5055

# Shared secret openHop must send in its AUTH handshake. Leave empty
# for no auth (fine on a trusted home LAN).
token =

# Demo feed: injects a clearly-labeled synthetic test packet every
# demo_interval seconds, for end-to-end testing (watch it appear in
# openHop's packet log). Leave off in normal use.
demo_feed = false
demo_interval = 10

# Feed input: where the radio owner (e.g. the bot) pushes packets it
# hears or transmits. Protected by construction:
#   - feed_bind 127.0.0.1 = only this machine can reach the feed port
#     (use 0.0.0.0 ONLY with a firewall rule limiting the bot's IP)
#   - feed_token is MANDATORY - the feed port does not open without
#     one; the bot must send this exact token to push
#   - one feed client at a time; a correct-token newcomer displaces
#     a stale one, wrong tokens are rejected
feed_bind = 127.0.0.1
feed_port = 5056
feed_token =
